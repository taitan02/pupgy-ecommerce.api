# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches ecommerce-infrastructure/docker/docker-compose.dev.yml
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5442/ecommerce?schema=public"
SHADOW_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5443/shadow_diff?schema=public"
TEST_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5443/ecommerce_test?schema=public"
REDIS_URL="redis://localhost:6389"

# Storefront and Admin dev servers
# openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-0123456789abcdefghijklmnop"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_MS=10000

# Login throttling: 5 attempts per email and 30 per IP, per 5 minutes.
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_AUTH_PER_IP=30
# true in production (HTTPS only)
COOKIE_SECURE=false

CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Swagger UI at /docs. Must be false in production.
SWAGGER_ENABLED=true

# Object storage (MinIO locally — see ecommerce-infrastructure/docker)
S3_ENDPOINT="http://localhost:9000"
S3_REGION=auto
S3_BUCKET=ecommerce-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL="http://localhost:9000/ecommerce-dev"

# --- Cloudflare R2 (staging / production) ---
# Create an R2 bucket, then an API token with Object Read & Write for it.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_BUCKET=<bucket-name>
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Public read comes from the bucket's public r2.dev URL or a custom domain —
# the API token above stays private and is never sent to the browser.
# S3_PUBLIC_BASE_URL="https://<public-bucket-domain>"

# --- Mail ---
# Locally this is Mailpit from ecommerce-infrastructure/docker; read what was sent at
# http://localhost:8025. Nothing leaves the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="no-reply@pupgy.local"
MAIL_FROM_NAME=Pupgy

# --- SendGrid SMTP relay (staging / production) ---
# The username is the literal string `apikey`; the password is the API key itself.
# MAIL_FROM must be on a domain you completed Domain Authentication for, otherwise
# SendGrid signs nothing and mailbox providers treat it as spam.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=<sendgrid-api-key>
# MAIL_FROM="no-reply@<your-authenticated-domain>"

# Where emails link to.
STOREFRONT_URL="http://localhost:3001"
SELLER_URL="http://localhost:3002"

PASSWORD_RESET_TTL_MINUTES=30

# --- Bull Board (queue dashboard) ---
# Off by default. It shows job payloads and can delete or replay jobs, so it is an
# admin surface: the API refuses to start with it enabled and no password set.
# Reach it at http://localhost:3000/admin/queues
BULL_BOARD_ENABLED=false
BULL_BOARD_USER=admin
# BULL_BOARD_PASSWORD=<choose-one>

# --- Payments (ADR-015: the platform receives, holds, then releases) ---
# One SePay account, the platform's. Buyers transfer into it.
SEPAY_BANK_CODE=Vietcombank
SEPAY_ACCOUNT_NUMBER=0010000000355
SEPAY_ACCOUNT_NAME="PUPGY JSC"
# From the SePay webhook configuration. Empty means the webhook refuses everything.
SEPAY_WEBHOOK_SECRET=""
# 500 = 5%, snapshotted onto each order at placement.
COMMISSION_RATE_BPS=500
# Days after delivery before escrow releases without the buyer confirming.
AUTO_RELEASE_DAYS=3
PAYMENT_EXPIRY_MINUTES=15

# --- AI (Phase 9) -------------------------------------------------------------
# Paste your own key; it is never committed. Leaving it empty makes every AI
# endpoint answer 503 instead of failing in the middle of a stream.
ANTHROPIC_API_KEY=""
# Leave empty for Anthropic's own endpoint; set it to point at a gateway or a local
# stand-in.
ANTHROPIC_BASE_URL=""
AI_MODEL="claude-opus-5-5"
AI_EFFORT="low"
AI_MAX_OUTPUT_TOKENS=2048
AI_HISTORY_WINDOW=20
AI_DAILY_MESSAGE_QUOTA=50
AI_DAILY_TOKEN_QUOTA=200000
