# Used by tests only (NODE_ENV=test). Points at the throwaway test database whose
# data lives in tmpfs, so tests never touch anything you were looking at in dev.
NODE_ENV=test
PORT=3100
LOG_LEVEL=warn

DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5443/ecommerce_test?schema=public"
# Redis database 1: tests flush it, so it must not be the one dev uses.
REDIS_URL="redis://localhost:6389/1"

JWT_SECRET="test-only-secret-0123456789abcdefghijklmnopqrstuvwxyz"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Strict rotation in tests: any reuse must be detected. The grace window has its own
# unit test (token.service.spec.ts).
REFRESH_REUSE_GRACE_MS=0

# The per-email limit is what the rate-limit suite exercises; the per-IP limit is
# raised because every test request comes from the same loopback address.
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_AUTH_PER_IP=100000

CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
SWAGGER_ENABLED=false
COOKIE_SECURE=false

# Tests upload to a separate MinIO bucket so they never mix with dev files.
S3_ENDPOINT="http://localhost:9000"
S3_REGION=auto
S3_BUCKET=ecommerce-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL="http://localhost:9000/ecommerce-test"

SEPAY_WEBHOOK_SECRET="test-webhook-secret-not-a-real-one"
PAYMENT_EXPIRY_MINUTES=15

# AI. The key only has to be non-empty: the e2e suite replaces the provider with a
# stub, so no request ever leaves the machine.
ANTHROPIC_API_KEY="test-key-not-used"
AI_DAILY_MESSAGE_QUOTA=3
AI_DAILY_TOKEN_QUOTA=1000
