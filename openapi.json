  "info": {
    "title": "Ecommerce Marketplace API",
    "description": "Contract between ecommerce-api and its consumers (storefront, admin). Additive changes only within v1 — see docs/api/versioning.md.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "storefront/categories",
      "description": "Public catalog taxonomy"
    },
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "tai@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "minLength": 10,
            "description": "Minimum 10 characters. Length beats character-class rules."
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Tài"
          },
          "phone": {
            "type": "string",
            "example": "0901234567"
          },
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ],
            "description": "Which app this session is for (ADR-007)"
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "fullName"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT. Keep in memory; never in localStorage."
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "tai@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery"
          },
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ]
          }
        },
        "required": [
          "audience"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "CreateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tai Store"
          },
          "slug": {
            "type": "string",
            "example": "tai-store",
            "description": "Public URL segment: /shop/{slug}. Lowercase letters, digits and dashes."
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "ShopResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "status"
        ]
      },
      "MyShopDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ],
            "description": "Your role in this shop"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "UpdateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ShopMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
