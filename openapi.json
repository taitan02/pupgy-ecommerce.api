{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The Retry-After header says how long to wait."
          }
        },
        "summary": "Create an account and start a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The Retry-After header says how long to wait."
          }
        },
        "summary": "Exchange credentials for a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The Retry-After header says how long to wait."
          }
        },
        "summary": "Rotate the refresh token and issue a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "429": {
            "description": "Rate limit exceeded. The Retry-After header says how long to wait."
          }
        },
        "summary": "Revoke the session family and clear the cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The Retry-After header says how long to wait."
          }
        },
        "summary": "The authenticated user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/seller/shops": {
      "post": {
        "operationId": "SellerShopController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShopDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a shop; the caller becomes its owner",
        "tags": [
          "seller/shops"
        ]
      },
      "get": {
        "operationId": "SellerShopController_listMine",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyShopDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Shops the caller belongs to (feeds the shop switcher)",
        "tags": [
          "seller/shops"
        ]
      }
    },
    "/api/v1/seller/shops/current": {
      "get": {
        "operationId": "SellerShopController_current",
        "parameters": [
          {
            "name": "x-shop-id",
            "in": "header",
            "description": "Selected shop; re-authorised per request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "The currently selected shop",
        "tags": [
          "seller/shops"
        ]
      },
      "patch": {
        "operationId": "SellerShopController_update",
        "parameters": [
          {
            "name": "x-shop-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShopDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update shop details (owner only)",
        "tags": [
          "seller/shops"
        ]
      }
    },
    "/api/v1/seller/shops/current/members": {
      "get": {
        "operationId": "SellerShopController_listMembers",
        "parameters": [
          {
            "name": "x-shop-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShopMemberDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List members of the selected shop",
        "tags": [
          "seller/shops"
        ]
      },
      "post": {
        "operationId": "SellerShopController_addMember",
        "parameters": [
          {
            "name": "x-shop-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Add an existing platform user to the shop (owner only)",
        "tags": [
          "seller/shops"
        ]
      }
    },
    "/api/v1/seller/shops/current/members/{userId}": {
      "delete": {
        "operationId": "SellerShopController_removeMember",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-shop-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Remove a member (owner only; the last owner cannot be removed)",
        "tags": [
          "seller/shops"
        ]
      }
    },
    "/api/v1/storefront/categories": {
      "get": {
        "operationId": "StorefrontCategoryController_getTree",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get the platform category tree",
        "tags": [
          "storefront/categories"
        ]
      }
    }
  },
  "info": {
    "title": "Ecommerce Marketplace API",
    "description": "Contract between ecommerce-api and its consumers (storefront, admin). Additive changes only within v1 — see docs/api/versioning.md.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "storefront/categories",
      "description": "Public catalog taxonomy"
    },
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "tai@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "minLength": 10,
            "description": "Minimum 10 characters. Length beats character-class rules."
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Tài"
          },
          "phone": {
            "type": "string",
            "example": "0901234567"
          },
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ],
            "description": "Which app this session is for (ADR-007)"
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "fullName"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT. Keep in memory; never in localStorage."
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "tai@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery"
          },
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "audience": {
            "type": "string",
            "enum": [
              "STOREFRONT",
              "SELLER"
            ]
          }
        },
        "required": [
          "audience"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "CreateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tai Store"
          },
          "slug": {
            "type": "string",
            "example": "tai-store",
            "description": "Public URL segment: /shop/{slug}. Lowercase letters, digits and dashes."
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "ShopResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "status"
        ]
      },
      "MyShopDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ],
            "description": "Your role in this shop"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "UpdateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ShopMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "fullName",
          "role"
        ]
      },
      "AddMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Must already have a platform account"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Điện thoại"
          },
          "slug": {
            "type": "string",
            "example": "dien-thoai",
            "description": "URL segment, unique platform-wide"
          },
          "children": {
            "description": "Direct children, ordered",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "children"
        ]
      }
    }
  }
}
