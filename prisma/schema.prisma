generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for migrations) and is
// passed to PrismaClient through a driver adapter (see infra/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum TokenAudience {
  STOREFRONT
  SELLER

  @@map("token_audience")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED

  @@map("shop_status")
}

enum ShopRole {
  OWNER
  STAFF

  @@map("shop_role")
}

/// One identity for the whole platform (ADR-007). Being a merchant is not a property
/// of the user — it is having a ShopMember row.
model User {
  id           String     @id @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(120)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  memberships ShopMember[]

  @@map("users")
}

/// One row per issued refresh token. Rotation writes a new row in the same family;
/// presenting an already-used token revokes the whole family (ADR-007).
model Session {
  id String @id @db.Uuid
  /// Survives rotation: every token descended from one login shares this id.
  familyId String @map("family_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// SHA-256 of the token. The plaintext exists only in the client's cookie, so a
  /// database dump cannot be replayed.
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  audience  TokenAudience
  /// Set when this token is exchanged. A second exchange is a reuse attempt.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, audience])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A merchant's shop. Shop-private data hangs off this id, and `shop_id` is the
/// isolation key the whole application relies on (ADR-006).
model Shop {
  id          String     @id @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.VarChar(500)
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ShopMember[]
  products Product[]

  @@map("shops")
}

/// Membership is the authorisation fact: no row, no access to that shop's data.
model ShopMember {
  id        String   @id @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ShopRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per shop; the role lives on that single row.
  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

/// Platform-wide category tree, owned by the platform rather than by any shop
/// (ADR-001: this is a marketplace, so shops list into a shared taxonomy).
model Category {
  // UUIDv7 generated by the application: time-ordered, so inserts stay at the
  // right edge of the index instead of scattering like UUIDv4.
  id        String   @id @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict, not Cascade: deleting a parent category must never silently delete
  // its subtree (and, later, orphan every product listed under it).
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED

  @@map("product_status")
}

/// A shop's listing. Public once ACTIVE, but the row is shop-private data: every
/// query that is not the public catalog filters by shop_id (ADR-006).
model Product {
  id          String        @id @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(200)
  /// Unique per shop, not globally: two shops may both sell "áo thun trắng".
  slug        String        @db.VarChar(220)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)

  // Shipping dimensions, used later to price delivery. Nullable because a draft is
  // saved long before the merchant has weighed anything.
  weightGrams Int? @map("weight_grams")
  lengthCm    Int? @map("length_cm")
  widthCm     Int? @map("width_cm")
  heightCm    Int? @map("height_cm")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  ProductOption[]
  skus     Sku[]
  images   ProductImage[]

  @@unique([shopId, slug])
  // Lets children reference (shop_id, product_id) together, so a child can never
  // point at another shop's product.
  @@unique([id, shopId])
  @@index([shopId, status, createdAt])
  @@index([categoryId, status])
  @@map("products")
}

/// A variation axis, e.g. "Màu sắc". At most two per product (Shopee's model);
/// enforced in the service, because a count limit is not expressible as a constraint.
model ProductOption {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  name      String @db.VarChar(60)
  /// 1 or 2: which axis this is. Drives the order shown on the product page.
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, position])
  @@index([shopId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @db.Uuid
  optionId String @map("option_id") @db.Uuid
  shopId   String @map("shop_id") @db.Uuid
  value    String @db.VarChar(60)
  position Int

  option        ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  skusAsFirst   Sku[]         @relation("SkuOptionValue1")
  skusAsSecond  Sku[]         @relation("SkuOptionValue2")

  @@unique([optionId, value])
  @@map("product_option_values")
}

/// The thing that is actually bought: one combination of option values, with its own
/// price and stock. A product with no options has exactly one SKU.
model Sku {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  /// Merchant's own code, unique per shop when provided.
  code      String? @db.VarChar(64)
  /// Integer VND. There is no minor unit, and floats have no place near money.
  price     Int
  stock     Int     @default(0)
  /// A combination that exists in the grid but is not offered — the storefront
  /// strikes it through rather than hiding it, so shoppers see why it is unavailable.
  isSellable Boolean @default(true) @map("is_sellable")

  /// Two columns instead of a join table: the product rule caps variations at two
  /// axes, so "find the SKU for this combination" stays a single WHERE.
  optionValue1Id String? @map("option_value_1_id") @db.Uuid
  optionValue2Id String? @map("option_value_2_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Composite reference: a SKU cannot belong to another shop's product, whatever
  // the application layer does (ADR-006).
  product      Product             @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  optionValue1 ProductOptionValue? @relation("SkuOptionValue1", fields: [optionValue1Id], references: [id], onDelete: Restrict)
  optionValue2 ProductOptionValue? @relation("SkuOptionValue2", fields: [optionValue2Id], references: [id], onDelete: Restrict)

  @@unique([shopId, code])
  // One SKU per option combination.
  //
  // Declared here so Prisma owns the index: an index that exists only in migration
  // SQL is invisible to the schema diff, and the next `migrate dev` drops it. (That
  // happened once — the SKU-combination test caught it.)
  //
  // Prisma 7 cannot express NULLS NOT DISTINCT, so the migration re-creates this
  // index with that clause under the same name. Without it Postgres treats every
  // NULL as unique, and a product with no options could accumulate duplicate SKUs.
  @@unique([productId, optionValue1Id, optionValue2Id], map: "skus_product_option_combination_key")
  @@index([productId])
  @@map("skus")
}

/// An uploaded product photo. The bytes live in object storage (R2 in production,
/// MinIO locally); this row is the record of what was uploaded and in what order.
model ProductImage {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  /// Object key, e.g. shops/{shopId}/products/{productId}/{uuid}.jpg. The public URL
  /// is built from it, so moving bucket or domain does not require a data migration.
  storageKey  String @unique @map("storage_key") @db.VarChar(400)
  contentType String @map("content_type") @db.VarChar(80)
  sizeBytes   Int    @map("size_bytes")
  alt         String? @db.VarChar(200)
  /// 0 is the cover image shown in listings.
  position    Int    @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Same composite reference as SKUs: an image cannot belong to another shop's
  // product, whatever the application layer does (ADR-006).
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}
