generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for migrations) and is
// passed to PrismaClient through a driver adapter (see infra/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum TokenAudience {
  STOREFRONT
  SELLER

  @@map("token_audience")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED

  @@map("shop_status")
}

enum ShopRole {
  OWNER
  STAFF

  @@map("shop_role")
}

/// One identity for the whole platform (ADR-007). Being a merchant is not a property
/// of the user — it is having a ShopMember row.
model User {
  id           String     @id @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(120)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  memberships ShopMember[]
  addresses   Address[]
  cartItems   CartItem[]
  orders      Order[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// One row per issued refresh token. Rotation writes a new row in the same family;
/// presenting an already-used token revokes the whole family (ADR-007).
model Session {
  id String @id @db.Uuid
  /// Survives rotation: every token descended from one login shares this id.
  familyId String @map("family_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// SHA-256 of the token. The plaintext exists only in the client's cookie, so a
  /// database dump cannot be replayed.
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  audience  TokenAudience
  /// Set when this token is exchanged. A second exchange is a reuse attempt.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, audience])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A merchant's shop. Shop-private data hangs off this id, and `shop_id` is the
/// isolation key the whole application relies on (ADR-006).
model Shop {
  id          String     @id @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.VarChar(500)
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ShopMember[]
  products Product[]
  orders   Order[]
  paymentAccount ShopPaymentAccount?
  paymentEvents  PaymentEvent[]

  @@map("shops")
}

/// Membership is the authorisation fact: no row, no access to that shop's data.
model ShopMember {
  id        String   @id @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ShopRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per shop; the role lives on that single row.
  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

/// Platform-wide category tree, owned by the platform rather than by any shop
/// (ADR-001: this is a marketplace, so shops list into a shared taxonomy).
model Category {
  // UUIDv7 generated by the application: time-ordered, so inserts stay at the
  // right edge of the index instead of scattering like UUIDv4.
  id        String   @id @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict, not Cascade: deleting a parent category must never silently delete
  // its subtree (and, later, orphan every product listed under it).
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED

  @@map("product_status")
}

/// A shop's listing. Public once ACTIVE, but the row is shop-private data: every
/// query that is not the public catalog filters by shop_id (ADR-006).
model Product {
  id          String        @id @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(200)
  /// Unique per shop, not globally: two shops may both sell "áo thun trắng".
  slug        String        @db.VarChar(220)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)

  // Shipping dimensions, used later to price delivery. Nullable because a draft is
  // saved long before the merchant has weighed anything.
  weightGrams Int? @map("weight_grams")
  lengthCm    Int? @map("length_cm")
  widthCm     Int? @map("width_cm")
  heightCm    Int? @map("height_cm")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  ProductOption[]
  skus     Sku[]
  images   ProductImage[]

  @@unique([shopId, slug])
  // Lets children reference (shop_id, product_id) together, so a child can never
  // point at another shop's product.
  @@unique([id, shopId])
  @@index([shopId, status, createdAt])
  @@index([categoryId, status])
  @@map("products")
}

/// A variation axis, e.g. "Màu sắc". At most two per product (Shopee's model);
/// enforced in the service, because a count limit is not expressible as a constraint.
model ProductOption {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  name      String @db.VarChar(60)
  /// 1 or 2: which axis this is. Drives the order shown on the product page.
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, position])
  @@index([shopId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @db.Uuid
  optionId String @map("option_id") @db.Uuid
  shopId   String @map("shop_id") @db.Uuid
  value    String @db.VarChar(60)
  position Int

  option        ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  skusAsFirst   Sku[]         @relation("SkuOptionValue1")
  skusAsSecond  Sku[]         @relation("SkuOptionValue2")

  @@unique([optionId, value])
  @@map("product_option_values")
}

/// The thing that is actually bought: one combination of option values, with its own
/// price and stock. A product with no options has exactly one SKU.
model Sku {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  /// Merchant's own code, unique per shop when provided.
  code      String? @db.VarChar(64)
  /// Integer VND. There is no minor unit, and floats have no place near money.
  price     Int
  stock     Int     @default(0)
  /// A combination that exists in the grid but is not offered — the storefront
  /// strikes it through rather than hiding it, so shoppers see why it is unavailable.
  isSellable Boolean @default(true) @map("is_sellable")

  /// Two columns instead of a join table: the product rule caps variations at two
  /// axes, so "find the SKU for this combination" stays a single WHERE.
  optionValue1Id String? @map("option_value_1_id") @db.Uuid
  optionValue2Id String? @map("option_value_2_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Composite reference: a SKU cannot belong to another shop's product, whatever
  // the application layer does (ADR-006).
  product      Product             @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  optionValue1 ProductOptionValue? @relation("SkuOptionValue1", fields: [optionValue1Id], references: [id], onDelete: Restrict)
  optionValue2 ProductOptionValue? @relation("SkuOptionValue2", fields: [optionValue2Id], references: [id], onDelete: Restrict)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  movements    InventoryMovement[]

  @@unique([shopId, code])
  // Lets a cart line reference (sku_id, shop_id) together, so the shop a line is
  // grouped under cannot drift from the shop that actually sells the SKU.
  @@unique([id, shopId])
  // One SKU per option combination.
  //
  // Declared here so Prisma owns the index: an index that exists only in migration
  // SQL is invisible to the schema diff, and the next `migrate dev` drops it. (That
  // happened once — the SKU-combination test caught it.)
  //
  // Prisma 7 cannot express NULLS NOT DISTINCT, so the migration re-creates this
  // index with that clause under the same name. Without it Postgres treats every
  // NULL as unique, and a product with no options could accumulate duplicate SKUs.
  @@unique([productId, optionValue1Id, optionValue2Id], map: "skus_product_option_combination_key")
  @@index([productId])
  @@map("skus")
}

/// An uploaded product photo. The bytes live in object storage (R2 in production,
/// MinIO locally); this row is the record of what was uploaded and in what order.
model ProductImage {
  id        String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  /// Object key, e.g. shops/{shopId}/products/{productId}/{uuid}.jpg. The public URL
  /// is built from it, so moving bucket or domain does not require a data migration.
  storageKey  String @unique @map("storage_key") @db.VarChar(400)
  contentType String @map("content_type") @db.VarChar(80)
  sizeBytes   Int    @map("size_bytes")
  alt         String? @db.VarChar(200)
  /// 0 is the cover image shown in listings.
  position    Int    @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Same composite reference as SKUs: an image cannot belong to another shop's
  // product, whatever the application layer does (ADR-006).
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}


/// A delivery address in the buyer's address book.
///
/// Vietnam dropped the district level on 1 July 2025, so an address is
/// province → ward → street, not province → district → ward. The codes are
/// nullable because the official administrative-unit dataset is not loaded yet;
/// the names are what the shop actually ships to, and they are stored here rather
/// than resolved from a dataset so a later renaming cannot rewrite history.
model Address {
  id            String  @id @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  recipientName String  @map("recipient_name") @db.VarChar(120)
  phone         String  @db.VarChar(20)
  provinceCode  String? @map("province_code") @db.VarChar(16)
  provinceName  String  @map("province_name") @db.VarChar(120)
  wardCode      String? @map("ward_code") @db.VarChar(16)
  wardName      String  @map("ward_name") @db.VarChar(120)
  streetLine    String  @map("street_line") @db.VarChar(200)
  /// Buyer's own note: "Nhà riêng", "Văn phòng".
  label         String? @db.VarChar(40)
  /// Pre-selected at checkout. Exactly one per user, kept true in a transaction
  /// (Prisma 7 cannot declare the partial unique index that would enforce it, and an
  /// index that lives only in migration SQL gets dropped by the next `migrate dev`).
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("addresses")
}

/// One line of the buyer's cart. There is no Cart row: the user is the cart, which
/// removes a lifecycle (create, expire, merge) that buys nothing while carts are
/// account-only.
///
/// `shop_id` is stored rather than joined through the SKU because the cart is read
/// grouped by shop on every page load, and the composite reference below makes the
/// denormalisation safe.
model CartItem {
  id       String @id @db.Uuid
  userId   String @map("user_id") @db.Uuid
  shopId   String @map("shop_id") @db.Uuid
  skuId    String @map("sku_id") @db.Uuid
  quantity Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: a SKU that no longer exists cannot be priced or shipped, so the line
  // goes with it. A SKU that still exists but is no longer on sale is a different
  // case — the line stays and the cart marks it unavailable.
  sku  Sku  @relation(fields: [skuId, shopId], references: [id, shopId], onDelete: Cascade)

  /// Adding the same SKU twice increases the quantity instead of creating a second line.
  @@unique([userId, skuId])
  @@index([userId, shopId])
  @@map("cart_items")
}

enum OrderStatus {
  /// Placed, stock already taken, waiting for the bank transfer to arrive. Only
  /// SEPAY_QR orders start here; COD orders start at PENDING (ADR-014).
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  COD
  SEPAY_QR

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PAID

  @@map("payment_status")
}

enum CancelledBy {
  BUYER
  SELLER
  /// The expiry job. "Nobody" is not an answer a buyer accepts when their order
  /// disappears, so the system owns its own cancellations (ADR-014).
  SYSTEM

  @@map("cancelled_by")
}

enum InventoryReason {
  ORDER_PLACED
  ORDER_CANCELLED

  @@map("inventory_reason")
}

/// One shop's part of a checkout (ADR-012). Three shops in a cart means three orders:
/// each ships its own parcel and is paid directly, so there is nothing for a parent
/// row to hold that would be true of all of them.
///
/// The address and the totals are copies, not references. An order is a record of what
/// was agreed, and editing an address or a price must not rewrite it.
model Order {
  id     String @id @db.Uuid
  /// What a buyer reads out to the shop. Short, unambiguous, and not the primary key,
  /// because a key that is printed on a parcel is a key people will try to guess.
  code   String @unique @db.VarChar(20)
  shopId String @map("shop_id") @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  recipientName String  @map("recipient_name") @db.VarChar(120)
  phone         String  @db.VarChar(20)
  provinceName  String  @map("province_name") @db.VarChar(120)
  wardName      String  @map("ward_name") @db.VarChar(120)
  streetLine    String  @map("street_line") @db.VarChar(200)
  /// Buyer's message to the shop ("giao giờ hành chính").
  note          String? @db.VarChar(500)

  /// Integer VND. Stored rather than summed on read: the lines can be recomputed, the
  /// agreed total cannot.
  itemsSubtotal Int @map("items_subtotal")
  shippingFee   Int @map("shipping_fee")
  total         Int

  placedAt    DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  cancelledBy  CancelledBy? @map("cancelled_by")
  cancelReason String?      @map("cancel_reason") @db.VarChar(200)

  /// Client-generated, one per checkout attempt. A resubmitted form hits this unique
  /// index and gets the first order back instead of placing a second one.
  idempotencyKey String? @map("idempotency_key") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  items     OrderItem[]
  movements InventoryMovement[]
  payment   Payment?

  @@unique([buyerId, idempotencyKey])
  // Same composite trick as products: lets a line reference (order_id, shop_id)
  // together, so a line can never be filed under a different shop than its order.
  @@unique([id, shopId])
  // The seller's list: one shop, optionally one status, newest first. Ids are UUIDv7,
  // so ordering by id is ordering by time and the cursor needs no second column.
  @@index([shopId, status, id])
  @@index([buyerId, id])
  @@map("orders")
}

/// A line as it was bought. Every field the buyer sees is a copy; `sku_id` is kept for
/// stock accounting and restocking, under RESTRICT so a sold variation cannot be
/// deleted out from under it (ADR-012).
model OrderItem {
  id      String @id @db.Uuid
  orderId String @map("order_id") @db.Uuid
  shopId  String @map("shop_id") @db.Uuid
  skuId   String @map("sku_id") @db.Uuid

  productId   String @map("product_id") @db.Uuid
  productName String @map("product_name") @db.VarChar(200)
  /// Snapshotted with the name so an order line links to the product without reading
  /// the catalog. A later rename still resolves: the id decides which product is
  /// served and the page redirects to the current spelling.
  productSlug String @map("product_slug") @db.VarChar(220)
  /// Rendered as "Đen / L". Empty for a product without variations.
  optionValues String[] @map("option_values")
  /// The image key at the time of purchase, so the thumbnail survives a re-upload.
  imageKey    String? @map("image_key") @db.VarChar(400)

  unitPrice Int @map("unit_price")
  quantity  Int
  lineTotal Int @map("line_total")

  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId, shopId], references: [id, shopId], onDelete: Restrict)

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

/// Every stock change, with the reason and the order behind it. Without it, `stock` is
/// a number that moves for reasons nobody recorded, and a disputed count has no answer.
model InventoryMovement {
  id      String  @id @db.Uuid
  shopId  String  @map("shop_id") @db.Uuid
  skuId   String  @map("sku_id") @db.Uuid
  orderId String? @map("order_id") @db.Uuid
  /// Negative when stock leaves, positive when it comes back.
  delta   Int
  reason  InventoryReason
  /// Stock after this movement, as the transaction saw it. Lets the ledger be checked
  /// against the SKU without replaying every row.
  stockAfter Int @map("stock_after")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sku   Sku    @relation(fields: [skuId, shopId], references: [id, shopId], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([skuId, id])
  @@index([shopId, id])
  @@map("inventory_movements")
}

/// A one-shot password-reset link.
///
/// Only the SHA-256 lives here: the plaintext exists in the email and nowhere else, so
/// a database dump cannot be used to take over accounts — the same reasoning as
/// refresh tokens (ADR-007).
model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set the moment it is redeemed. A second use is refused, not honoured.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum PaymentRecordStatus {
  PENDING
  PAID
  /// The buyer never paid and the window closed. The order is cancelled and the
  /// units go back (ADR-014).
  EXPIRED
  CANCELLED

  @@map("payment_record_status")
}

/// A shop's own SePay account: the bank account buyers transfer into, and the secret
/// that proves a webhook really came from SePay.
///
/// One per shop, because the platform never receives a payment (ADR-001). A shop
/// without a row here is simply not offered QR at checkout.
model ShopPaymentAccount {
  id     String @id @db.Uuid
  shopId String @unique @map("shop_id") @db.Uuid

  /// SePay's short bank name, e.g. "Vietcombank" — it goes straight into the QR URL.
  bankCode      String @map("bank_code") @db.VarChar(40)
  accountNumber String @map("account_number") @db.VarChar(40)
  /// Shown next to the QR so a buyer can see who they are paying.
  accountName   String @map("account_name") @db.VarChar(120)

  /// The random path segment in this shop's webhook URL. It exists to choose which
  /// secret to verify against before any payload can be trusted — it is not a
  /// credential, and knowing it does not let anyone forge a signature.
  webhookId String @unique @map("webhook_id") @db.VarChar(64)

  /// AES-256-GCM, not a hash. Verifying an HMAC means recomputing it, which needs the
  /// real key back — hash what you only ever compare, encrypt what you must replay.
  webhookSecretCipher String @map("webhook_secret_cipher") @db.VarChar(500)

  /// The merchant can switch QR off without deleting their bank details.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_payment_accounts")
}

/// The money side of one order. Separate from the order because an order is a
/// commitment to ship and a payment is a claim about a bank transfer; they fail,
/// expire and get argued about independently.
model Payment {
  id      String @id @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  shopId  String @map("shop_id") @db.Uuid

  /// Integer VND, copied from the order. The webhook must match this exactly: a
  /// partial transfer is a conversation, not a paid order.
  amount Int
  status PaymentRecordStatus @default(PENDING)

  /// What the buyer is told to put in the transfer memo, and what we look for in the
  /// webhook's `content`. The order code, since that is what the buyer already sees.
  reference String @db.VarChar(32)

  /// When the hold on the stock runs out.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(3)

  /// SePay's own transaction id, written at the moment the payment is accepted.
  providerTransactionId String? @map("provider_transaction_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("payments")
}

/// Every webhook body we accepted, kept raw.
///
/// The unique index on (shop, provider transaction) is the deduplication: SePay
/// retries up to seven times over five hours, so a repeated delivery is documented
/// behaviour, not an edge case. The insert and the payment update happen in one
/// transaction, so the index — not a prior check — decides who wins (ADR-014).
model PaymentEvent {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid

  providerTransactionId String @map("provider_transaction_id") @db.VarChar(64)
  /// Exactly what arrived. Disputes are settled against this, not against our
  /// interpretation of it.
  payload Json
  /// The payment it was matched to, or null when nothing matched — an unmatched
  /// transfer is still evidence and still worth keeping.
  paymentId String? @map("payment_id") @db.Uuid

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, providerTransactionId])
  @@index([shopId, receivedAt])
  @@map("payment_events")
}
