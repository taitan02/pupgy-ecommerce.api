generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for migrations) and is
// passed to PrismaClient through a driver adapter (see infra/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum TokenAudience {
  STOREFRONT
  SELLER

  @@map("token_audience")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED

  @@map("shop_status")
}

enum ShopRole {
  OWNER
  STAFF

  @@map("shop_role")
}

/// One identity for the whole platform (ADR-007). Being a merchant is not a property
/// of the user — it is having a ShopMember row.
model User {
  id           String     @id @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(120)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  memberships ShopMember[]

  @@map("users")
}

/// One row per issued refresh token. Rotation writes a new row in the same family;
/// presenting an already-used token revokes the whole family (ADR-007).
model Session {
  id String @id @db.Uuid
  /// Survives rotation: every token descended from one login shares this id.
  familyId String @map("family_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// SHA-256 of the token. The plaintext exists only in the client's cookie, so a
  /// database dump cannot be replayed.
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  audience  TokenAudience
  /// Set when this token is exchanged. A second exchange is a reuse attempt.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, audience])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A merchant's shop. Shop-private data hangs off this id, and `shop_id` is the
/// isolation key the whole application relies on (ADR-006).
model Shop {
  id          String     @id @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.VarChar(500)
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  members ShopMember[]

  @@map("shops")
}

/// Membership is the authorisation fact: no row, no access to that shop's data.
model ShopMember {
  id        String   @id @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ShopRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per shop; the role lives on that single row.
  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

/// Platform-wide category tree, owned by the platform rather than by any shop
/// (ADR-001: this is a marketplace, so shops list into a shared taxonomy).
model Category {
  // UUIDv7 generated by the application: time-ordered, so inserts stay at the
  // right edge of the index instead of scattering like UUIDv4.
  id        String   @id @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict, not Cascade: deleting a parent category must never silently delete
  // its subtree (and, later, orphan every product listed under it).
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  @@index([parentId, position])
  @@map("categories")
}
